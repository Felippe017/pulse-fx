# ===========================
# Pulse FX — Variáveis de Ambiente
# ===========================

# PostgreSQL
POSTGRES_USER=pulsefx
POSTGRES_PASSWORD=pulsefx_secret
POSTGRES_DB=pulsefx
DATABASE_URL=postgresql://pulsefx:pulsefx_secret@postgres:5432/pulsefx

# FRED API (obtenha em https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=your_fred_api_key_here

# API
API_PORT=3001
SYNC_TTL_MINUTES=60
ADMIN_KEY=pulse-fx-admin-key

# Frontend
VITE_API_URL=http://localhost:3001
